{
  "name": "@praxis/plugin-protocol",
  "version": "0.2.0",
  "description": "Versioned manifest and process handshake contracts for Praxis plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uestc-Praxis/praxis.git"
  },
  "homepage": "https://github.com/uestc-Praxis/praxis#readme",
  "bugs": {
    "url": "https://github.com/uestc-Praxis/praxis/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest-schema": "./schemas/manifest-v1.schema.json",
    "./handshake-schema": "./schemas/handshake-v1.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "http://127.0.0.1:4873/"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs plugin-protocol && tsc --build tsconfig.json --force --pretty false && node ../../scripts/build-workspaces.mjs plugin-protocol",
    "prepack": "npm run build"
  }
}
