{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "praxis://schemas/protocol-v1.json",
  "title": "Praxis NDJSON protocol v1",
  "oneOf": [
    { "$ref": "praxis://schemas/methods-v1.json#/$defs/request" },
    { "$ref": "praxis://schemas/methods-v1.json#/$defs/result" },
    { "$ref": "#/$defs/failure" },
    { "$ref": "praxis://schemas/events-v1.json#/$defs/notification" }
  ],
  "$defs": {
    "failure": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1 },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "data": {},
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
